[Unit]
Description=Maya DS4 - DeepSeek-V4.1-Flash Maya-XS local inference server (Project Maya engine)
Documentation=https://github.com/precisionailabsllc-collab/maya-xs-strix-halo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A systemd --user unit runs as you; paths below are rewritten by scripts/install.sh.
WorkingDirectory={{HOME}}/maya
Environment=HOME={{HOME}}
Environment=PATH={{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# Keep earlier turns' reasoning in the rendered prompt, so a turn continues the previous state. Without it the
# reference encoder rewrites the history every turn and neither prefix reuse nor the kept conversations
# (MAYA_DS4_SLOT_KEEP) can hit - every turn then re-reads its whole prompt (measured: 19.3 s -> 2.7 s).
# NOTE: the client must send reasoning_content back for this to work; see docs/SETUP.md section 5.
Environment=MAYA_DS4_KEEP_THINKING=1

# The engine pins host staging buffers for the expert DMA (GBs of flow rings and bounce buffers, not MBs) and, on
# an APU, pinned host memory comes out of the same GTT window as the GPU pool. Unlimited is the safe setting.
LimitMEMLOCK=infinity

# Loading reads the expert set ahead and fills the GPU pool: give it time, and account its memory so the journal
# shows what it holds.
TimeoutStartSec=infinity
MemoryAccounting=yes
# The pool is anonymous memory and cannot be reclaimed; the page cache beside it can. Hold the service high enough
# that the kernel reclaims cache rather than reaching for the desktop. Tune to your box: pool + dense weights + a
# few GB for the rest (this value suits DS4_POOL_GB=100 on a 128 GB machine).
MemoryHigh=108G

# The engine exits non-zero if the GPU pool or a shard is unusable; retry, but do not hammer a broken install.
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillMode=mixed

ExecStart={{HOME}}/maya/.venv/bin/python serve/server.py \
    --engine strata \
    --config {{HOME}}/maya/ds4-config.json \
    --host 127.0.0.1 \
    --port 17866

[Install]
WantedBy=default.target
