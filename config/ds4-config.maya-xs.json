{
 "_": "maya-ds4: DeepSeek-V4.1-Flash-1017 Maya-S on the Strix Halo APU (gfx1151). Read by serve/server.py --engine strata, which runs `<exe> --serve <args>`.",
 "exe": "{{HOME}}/maya/build-hip/maya-ds4",
 "args": [
  "--pack",
  "{{HOME}}/models/DeepSeek-V4.1-Flash-1017-Maya-GGUF/Maya-XS/maya-ds4",
  "--max-context",
  "65536",
  "--reserve-mib",
  "512",
  "--dspark",
  "on",
  "--verbose",
  "--dspark-conf",
  "0.65",
  "--prefill-chunk",
  "8192"
 ],
 "env": {
  "DS4_POOL_GB": "100",
  "DS4_RING_MB": "512",
  "DS4_READERS": "16",
  "DS4_PREFIX_REUSE": "1",
  "MAYA_DS4_PROMPT_SKIP": "2",
  "DS4_SKIP_UNPICKED": "1",
  "MAYA_DS4_SLOT_KEEP": "1",
  "MAYA_DS4_SLOT_CAP": "4",
  "MAYA_DS4_SLOT_GB": "4",
  "DS4_PREFIX_STRIDE": "8192",
  "MAYA_DS4_Q8_BATCH": "1"
 },
 "cwd": "{{HOME}}/maya/build-hip",
 "tokenizer": "{{HOME}}/models/DeepSeek-V4.1-Flash-1017-Maya-GGUF/Maya-XS/maya-ds4/tokenizer",
 "model_name": "deepseek-v4.1-flash-1017-maya-s",
 "backend": "hip",
 "log": "{{HOME}}/.local/state/maya-ds4/engine.log"
}